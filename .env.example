# Database (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Admin API key for front-desk, dashboard and privacy endpoints
ADMIN_API_KEY=change-me

# Server
PORT=4000
LOG_LEVEL=info

# Session lifecycle
SESSION_INACTIVITY_HOURS=36
SESSION_EXPIRY_DAYS=90

# Data retention (DPDP)
MESSAGE_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=400

# Claude brain (not yet enabled)
# ANTHROPIC_API_KEY=
