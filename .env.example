# Aria API - every environment variable the code reads. Generated by pnpm env:doc on 2026-10-07 - do not edit by hand.
# Copy to .env and fill in. Values are never committed.

# Platform key for server-to-server calls (the console's server actions, scripts, /jobs, /api/system/status). Never ships to a browser
ADMIN_API_KEY=

# During a key rotation: the old key, still accepted until every caller is on the new one, then removed
ADMIN_API_KEY_PREVIOUS=

# Legacy AiSensy - unused
AISENSY_API_KEY=

# Legacy AiSensy WhatsApp provider - unused when Meta direct is configured
AISENSY_API_URL=

# Legacy AiSensy - unused
AISENSY_CAMPAIGN=

# Legacy AiSensy - unused
AISENSY_PROJECT_ID=

# Anthropic API key - the brain. When the balance is exhausted every guest gets the fallback line and an ai_credits_exhausted alert is raised
ANTHROPIC_API_KEY=

# Cheaper model that fact-checks a reply that states a fact; off to disable
ANTHROPIC_CHECK_MODEL=

# Reply budget per model call, default 1200
ANTHROPIC_MAX_TOKENS=

# Main model, default claude-sonnet-4-6
ANTHROPIC_MODEL=

# Model that rewrites server confirmations in the guest's language; off to disable
ANTHROPIC_POLISH_MODEL=

# Public URL of the API, used in links inside emails
APP_BASE_URL=

# agent for the tool-using brain (production); unset for the form-filling brain
ARIA_BRAIN=

# on on exactly ONE instance - only that instance runs the scheduled jobs
ARIA_SCHEDULER=

# on (default): no message leaves for a guest without an opt-in on record. off disables the gate - for a test environment only, never production
CONSENT_GATE=

# Comma-separated console origins allowed to call the API
CORS_ORIGINS=

# Minutes before an unanswered table request escalates to the GM
DINING_ESCALATE_MINUTES=

# Signs console session tokens (login, verified by tenantGuard)
JWT_SECRET=

# Console session lifetime, e.g. 7d
JWT_TTL=

# Failed logins allowed per 15 minutes before lockout
LOGIN_ATTEMPTS_PER_15_MIN=

# debug, info, warn or error - default info
LOG_LEVEL=

# Days messages are kept before the nightly purge removes them
MESSAGE_RETENTION_DAYS=

# WhatsApp Cloud API token - must be the permanent aria-api system user token, never a personal one. Checked daily; alerts 14 days before expiry
META_ACCESS_TOKEN=

# Graph API version, default v21.0
META_API_VERSION=

# The Aria Meta app id (default 1335677035018392) - with META_APP_SECRET it lets the token's type and expiry be read
META_APP_ID=

# Verifies webhook signatures from Meta, and reads the token's expiry
META_APP_SECRET=

# Default WhatsApp phone number id (a hotel row can override with its own)
META_PHONE_NUMBER_ID=

# off stops every WhatsApp send (replies, templates, typing) - set by the load test on its own server copy; leave unset in production
META_SEND=

# Approved template name for the evening message; unset means text only while the 24h window is open
META_TEMPLATE_EVENING_NUDGE=

# Approved template name for the after-stay feedback message
META_TEMPLATE_FEEDBACK=

# Template language code, default en
META_TEMPLATE_LANG=

# Approved template name for the pre-checkout message
META_TEMPLATE_PRE_CHECKOUT=

# Approved template sent once a day to a guest whose 24-hour window closed while a message was waiting (default aria_hello); the held message goes when they reply
META_TEMPLATE_REENGAGE=

# Shared secret for Meta's webhook verification handshake
META_VERIFY_TOKEN=

# The production WhatsApp Business Account id (default 38265744036350087) - for listing templates: pnpm meta:check
META_WABA_ID=

# production on Render
NODE_ENV=

# Open-Meteo commercial key for live weather; unset uses the free tier
OPEN_METEO_API_KEY=

# Comma-separated addresses that receive critical alerts (AI down, credits out, WhatsApp refusing sends, token expiring, a job failing); unset means log and banner only
OPS_ALERT_EMAIL=

# HTTP port, default 4000 (Render sets it)
PORT=

# false stops all proactive messages
PROACTIVE_ENABLED=

# Requests per minute per caller on /api, default 120
RATE_LIMIT_PER_MINUTE=

# Set by Render; shown by /health, /api/system/status and in alerts
RENDER_GIT_COMMIT=

# Window in which a repeated ask is the same request (a chase bumps it to urgent), default 45
REQUEST_DEDUP_MINUTES=

# Days after which an untouched request is closed as expired, default 3
REQUEST_STALE_DAYS=

# Days after which any session is closed, default 90
SESSION_EXPIRY_DAYS=

# Hours of guest silence before the are-you-still-with-us check, default 36
SESSION_INACTIVITY_HOURS=

# Days closed sessions are kept before the nightly purge removes them
SESSION_RETENTION_DAYS=

# SMTP host; unset means Gmail
SMTP_HOST=

# App password for SMTP_USER
SMTP_PASS=

# SMTP port, default 465
SMTP_PORT=

# Mailbox that sends staff invites, confirmations and alerts - must be Globotex's own, not a developer's
SMTP_USER=

# Supabase service-role key - server only, never in a browser
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project URL, for the admin client
SUPABASE_URL=

# Comma-separated phone numbers that are test guests - their orders and bookings are kept out of revenue
TEST_PHONES=

# Comma-separated phone prefixes (e.g. +9199999) that mark a test guest
TEST_PHONE_PREFIXES=

# Minutes a dining waitlist hold is kept before it expires
WAITLIST_HOLD_MINUTES=

# Legacy WATI - unused
WATI_ACCESS_TOKEN=

# Legacy WATI WhatsApp provider - unused
WATI_API_URL=

# Approved template name for the check-in welcome (guest_welcome)
WELCOME_TEMPLATE=
