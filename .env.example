# ---------------------------------------------------------------------------
# Aria API - environment variables
# Every variable the code reads is listed here (D-006). Never commit real values.
# Secrets live only in Render / your local .env.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) -------------------------------------------
# Pooled (transaction mode, port 6543) for the app; direct (port 5432) for migrations.
# URL-encode special characters in the password (an @ must be %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development                 # production refuses to start with weak secrets
LOG_LEVEL=info
# Browser origins allowed to call the API (comma separated). Add your Vercel domain in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Secrets (REQUIRED, long random strings) ---------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=                       # server-to-server key used by the dashboard
JWT_SECRET=                          # signs staff login tokens; >= 24 chars, never a placeholder
JWT_TTL=24h                          # how long a staff login lasts

# --- Meta WhatsApp Cloud API ---------------------------------------------------
META_ACCESS_TOKEN=                   # System User permanent token (not a personal user token)
META_PHONE_NUMBER_ID=                # default sending number; each hotel may override in the Hotel table
META_VERIFY_TOKEN=                   # your own random string, entered in the Meta webhook setup
META_APP_SECRET=                     # App Dashboard > App settings > Basic > App secret. REQUIRED: unsigned webhooks are rejected
META_API_VERSION=v21.0
WELCOME_TEMPLATE=guest_welcome       # approved template sent at check-in

# --- Claude brain --------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=800

# --- Supabase (service role, backend only - bypasses RLS, never ship to a browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (verification + password reset) -------------------------------------
SMTP_USER=                           # use a company transactional account, not a personal Gmail
SMTP_PASS=
APP_BASE_URL=http://localhost:3001   # dashboard URL used in emailed links

# --- Session lifecycle -----------------------------------------------------------
SESSION_INACTIVITY_HOURS=36
SESSION_EXPIRY_DAYS=90
REQUEST_DEDUP_MINUTES=90             # a follow-up within this window never re-creates an open request

# --- Data retention (DPDP) ---------------------------------------------------------
MESSAGE_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=400

# --- Operations tunables -------------------------------------------------------------
DINING_ESCALATE_MINUTES=15
WAITLIST_HOLD_MINUTES=30

# --- Legacy providers (not used on the Meta-direct setup; leave blank) ------------------
WATI_API_URL=
WATI_ACCESS_TOKEN=
AISENSY_API_KEY=
AISENSY_API_URL=
AISENSY_PROJECT_ID=
AISENSY_CAMPAIGN=
