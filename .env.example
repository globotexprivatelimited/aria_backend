# Aria API - every environment variable the code reads, generated from src/ on 2026-09-24
# Copy to .env and fill in. Values are never committed.

# Platform key for server-to-server calls (the console's server actions, scripts, the /jobs endpoint). Never ships to a browser
ADMIN_API_KEY=

# (read by the code - see the usage in src/)
AISENSY_API_KEY=

# (read by the code - see the usage in src/)
AISENSY_API_URL=

# (read by the code - see the usage in src/)
AISENSY_CAMPAIGN=

# (read by the code - see the usage in src/)
AISENSY_PROJECT_ID=

# Anthropic API key - the brain. When the balance is exhausted every guest gets the fallback line
ANTHROPIC_API_KEY=

# Cheaper model that fact-checks each reply against the hotel's material; off to disable
ANTHROPIC_CHECK_MODEL=

# Reply budget per model call, default 1200
ANTHROPIC_MAX_TOKENS=

# Main model, default claude-sonnet-4-6
ANTHROPIC_MODEL=

# Model that rewrites server confirmations in the guest's language; off to disable
ANTHROPIC_POLISH_MODEL=

# (read by the code - see the usage in src/)
APP_BASE_URL=

# agent for the tool-using brain (production), unset for the form-filling brain
ARIA_BRAIN=

# on on exactly ONE instance - only that instance runs the scheduled jobs
ARIA_SCHEDULER=

# (read by the code - see the usage in src/)
CORS_ORIGINS=

# (read by the code - see the usage in src/)
DINING_ESCALATE_MINUTES=

# Signs console session tokens (login, verified by tenantGuard)
JWT_SECRET=

# (read by the code - see the usage in src/)
JWT_TTL=

# (read by the code - see the usage in src/)
LOGIN_ATTEMPTS_PER_15_MIN=

# (read by the code - see the usage in src/)
LOG_LEVEL=

# (read by the code - see the usage in src/)
MESSAGE_RETENTION_DAYS=

# WhatsApp Cloud API token - must be the permanent aria-api system-user token, not a personal one
META_ACCESS_TOKEN=

# Graph API version, default v21.0
META_API_VERSION=

# Verifies webhook signatures from Meta
META_APP_SECRET=

# Default WhatsApp phone number id (a hotel row can override with its own)
META_PHONE_NUMBER_ID=

# Template language code, default en (en_US if created as English US)
META_TEMPLATE_LANG=

# (read by the code - see the usage in src/)
META_VERIFY_TOKEN=

# production on Render
NODE_ENV=

# Open-Meteo commercial key for live weather; unset uses the free tier
OPEN_METEO_API_KEY=

# HTTP port, default 4000 (Render sets it)
PORT=

# false to stop all proactive messages
PROACTIVE_ENABLED=

# (read by the code - see the usage in src/)
RATE_LIMIT_PER_MINUTE=

# Set by Render; shown by /health
RENDER_GIT_COMMIT=

# (read by the code - see the usage in src/)
REQUEST_DEDUP_MINUTES=

# Days after which an untouched request is closed as expired, default 3
REQUEST_STALE_DAYS=

# Days after which any session is closed, default 90
SESSION_EXPIRY_DAYS=

# Hours of guest silence before the are-you-still-with-us check, default 36
SESSION_INACTIVITY_HOURS=

# (read by the code - see the usage in src/)
SESSION_RETENTION_DAYS=

# (read by the code - see the usage in src/)
SMTP_PASS=

# (read by the code - see the usage in src/)
SMTP_USER=

# (read by the code - see the usage in src/)
SUPABASE_SERVICE_ROLE_KEY=

# (read by the code - see the usage in src/)
SUPABASE_URL=

# (read by the code - see the usage in src/)
WAITLIST_HOLD_MINUTES=

# (read by the code - see the usage in src/)
WATI_ACCESS_TOKEN=

# (read by the code - see the usage in src/)
WATI_API_URL=

# Approved template name for the check-in welcome (guest_welcome)
WELCOME_TEMPLATE=
